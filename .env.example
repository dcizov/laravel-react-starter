APP_NAME=Lattice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# `composer dev` serves the app on :8000, which Sail publishes as well.
# Prefer the container's own nginx (port 80)? Set this to http://localhost.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail starts a Postgres container named `pgsql`; these values match it.
# Running Lattice without Docker? SQLite needs no server — swap the block for:
#   DB_CONNECTION=sqlite
#   # DB_DATABASE=/absolute/path/to/database.sqlite  (defaults to database/)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=lattice
DB_USERNAME=sail
DB_PASSWORD=secret

# The uid/gid the container writes files with, so `storage/` and
# `bootstrap/cache/` stay owned by you on the host. `compose.yaml` defaults to
# 1000 — set these when yours differ (`id -u`, `id -g`).
#
# Keep them here rather than in your shell: compose interpolates from this file
# on the host, whereas under distrobox (`docker` → `distrobox-host-exec` →
# `host-spawn`) no variable exported in the container crosses the boundary —
# host-spawn forwards TERM and PWD only. That is what produces
# `WARN The "WWWUSER" variable is not set`.
# WWWUSER=1000
# WWWGROUP=1000

# Comma-separated proxy addresses/CIDRs that may set X-Forwarded-*. Empty is
# correct for `artisan serve`, Sail and any direct connection; set it to your
# load balancer (for example 172.16.0.0/12 for the Docker bridge) when Lattice
# runs behind one. Trusting every proxy lets a client forge its own IP.
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs/laravel.log, so a fresh clone needs no
# mail server. With Sail, switch to smtp + MAIL_HOST=mailpit for the UI at :8025.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
