{
    "handle": "PostCraft",
    "name": "PostCraft",
    "version": "1.0.0",
    "description": "A blog: posts, categories and tags with a public /blog, per-post pages, an RSS feed and a teaser section for any page.",
    "author": "Lattice",
    "provider": "App\\Addons\\PostCraft\\PostCraftServiceProvider",
    "requires": {
        "php": "^8.3",
        "laravel": "^13.0",
        "lattice": "^0.1"
    },
    "permissions": [
        "posts.view",
        "posts.create",
        "posts.update",
        "posts.delete",
        "posts.publish"
    ],
    "navigation": [
        {
            "section": "Content",
            "label": "Posts",
            "route": "/admin/posts",
            "icon": "newspaper",
            "permission": "posts.view",
            "order": 25
        }
    ],
    "migrations": true,
    "seeders": [],
    "sections": [{ "class": "App\\Addons\\PostCraft\\Sections\\BlogTeaser" }]
}
