{
    "name": "addons/newsletter",
    "slug": "newsletter",
    "version": "1.1.0",
    "label": "Newsletter",
    "core": "^1.0",
    "provider": "Addons\\Newsletter\\NewsletterServiceProvider",
    "requires": {
        "addons": {}
    },
    "provides": {
        "routes": "routes/web.php",
        "routes_mount": "root",
        "permissions": ["newsletter.manage"],
        "migrations": "database/migrations",
        "tables": ["newsletter_subscribers"],
        "pages": [
            { "page": "subscribe", "layout": "public", "url": "/newsletter" },
            { "page": "unsubscribed", "layout": "public" },
            { "page": "admin/newsletter", "layout": "app" }
        ]
    }
}
